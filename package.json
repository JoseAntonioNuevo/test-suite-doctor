{
  "name": "test-suite-doctor",
  "version": "0.3.0",
  "description": "Agent skill + compiled CLI to audit, minimize, and heal bloated Vitest/Jest test suites — per-test coverage metrics, greedy minimization, AI-slop detection, mutation-score verification.",
  "type": "module",
  "private": false,
  "packageManager": "pnpm@11.18.0",
  "license": "MIT",
  "author": "Jose Antonio Nuevo",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoseAntonioNuevo/test-suite-doctor.git"
  },
  "keywords": [
    "agent-skill",
    "claude-code",
    "test-minimization",
    "test-suite-reduction",
    "vitest",
    "jest",
    "mutation-testing",
    "coverage"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "test-suite-doctor": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "SKILL.md",
    "references",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node --import tsx tools/build.ts",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.17.1",
    "esbuild": "^0.28.1",
    "jest": "^30.4.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
